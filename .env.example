# Copy this file to .env.local. Never commit real values.

# Supabase server configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq server configuration
GROQ_API_KEY=your-groq-api-key
GROQ_EVALUATION_MODEL=your-reviewed-evaluation-model-id
GROQ_GENERATION_MODEL=your-reviewed-generation-model-id
GROQ_EVALUATION_TIMEOUT_MS=10000
GROQ_EVALUATION_MAX_RETRIES=1

# Comma-separated browser origins permitted to call the API.
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Backend-managed HttpOnly session cookie settings.
AUTH_SESSION_COOKIE_NAME=spark_session
AUTH_COOKIE_SECURE=false

# Generate these independently; never reuse Supabase/Groq credentials.
# AUTH_TOKEN_ENCRYPTION_KEY must be 32 random bytes encoded as base64.
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Backend session, refresh, and database-backed login limiter settings.
AUTH_SESSION_TTL_SECONDS=604800
AUTH_REFRESH_SKEW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
AUTH_TRUST_PROXY=false

# Development account provisioning (passwords are intentionally not listed).
# Set passwords only in .env.local or the current shell; never commit them.
SPARK_ENVIRONMENT_NAME=local
SPARK_ALLOW_DEV_PROVISIONING=false
DEV_TEACHER_EMAIL=teacher@example.test
DEV_TEACHER_UNASSIGNED_EMAIL=teacher-unassigned@example.test
DEV_STUDENT_NEW_EMAIL=new.student@example.test
DEV_STUDENT_RETURNING_EMAIL=returning.student@example.test

# Explicit real-integration target. Keep disabled unless this dedicated/local
# environment has been approved for testing; the harness never resets a DB.
SPARK_INTEGRATION_ENABLED=false
SPARK_INTEGRATION_BASE_URL=http://localhost:3000
SPARK_INTEGRATION_ORIGIN=http://localhost:3000

# Frontend adapter selection. Keep live mode explicit; it never falls back to mocks.
NEXT_PUBLIC_TUTOR_API_MODE=http
NEXT_PUBLIC_TUTOR_API_BASE_URL=/api/v1
