{
  "name": "spark-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "tsx --test tests/http.test.ts tests/mock.test.ts tests/pending-validation.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:test": "vitest run tests/database.test.ts",
    "db:provision:dev": "node scripts/provision-dev-accounts.mjs",
    "integration:preflight": "node scripts/integration-preflight.mjs",
    "integration:db-check": "node scripts/integration-db-check.mjs",
    "integration:auth-refresh": "node scripts/integration-auth-refresh.mjs",
    "integration:concurrency": "node scripts/integration-concurrency.mjs",
    "integration:test": "pnpm integration:preflight && vitest run --config vitest.integration.config.ts",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify": "pnpm verify:contract && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "groq-sdk": "latest",
    "lucide-react": "1.66.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "tailwind-merge": "3.7.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "^18.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "vitest": "latest",
    "tsx": "^4.23.15"
  }
}
